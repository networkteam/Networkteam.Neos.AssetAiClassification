{
  "name": "networkteam/neos-asset-ai-classification",
  "description": "AI classification for assets in the classic Neos Media Browser",
  "type": "neos-package",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "networkteam GmbH"
    }
  ],
  "require": {
    "php": "^8.0",
    "neos/neos": "^8.3",
    "neos/media-browser": "^8.3",
    "neos/fusion": "^8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "~9.1",
    "neos/buildessentials": "~8.3.0",
    "mikey179/vfsstream": "~1.6"
  },
  "autoload": {
    "psr-4": {
      "Networkteam\\Neos\\AssetAiClassification\\": "Classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Networkteam\\Neos\\AssetAiClassification\\Tests\\": "Tests/"
    }
  },
  "config": {
    "vendor-dir": "Packages/Libraries",
    "bin-dir": "bin",
    "allow-plugins": {
      "neos/composer-plugin": true
    }
  },
  "extra": {
    "neos": {
      "package-key": "Networkteam.Neos.AssetAiClassification"
    }
  }
}
